<?xml version="1.0"?>
<!-- Edge case: a virtual router (in a template) and a logical router (in a vsys) -->
<!-- coexist. Routes use next-vip and next-vr nexthops. Both router kinds and -->
<!-- all routes must parse with correct attribution. -->
<config version="10.0.0" urldb="paloaltonetworks">
  <templates>
    <entry name="FW-Template">
      <network>
        <virtual-router>
          <entry name="VR-MAIN">
            <interface>
              <member>ethernet1/1</member>
            </interface>
            <routing-table>
              <ip>
                <static-route>
                  <entry name="to-lr">
                    <destination>172.16.0.0/16</destination>
                    <nexthop>
                      <next-vr>LR-EDGE</next-vr>
                    </nexthop>
                  </entry>
                  <entry name="default-gw">
                    <destination>default</destination>
                    <nexthop>
                      <ip-address>192.168.1.254</ip-address>
                    </nexthop>
                    <metric>10</metric>
                  </entry>
                </static-route>
              </ip>
            </routing-table>
          </entry>
        </virtual-router>
      </network>
    </entry>
  </templates>
  <devices>
    <entry name="localhost.localdomain">
      <vsys>
        <entry name="vsys1">
          <network>
            <logical-router>
              <entry name="LR-EDGE">
                <interface>
                  <member>ethernet1/2</member>
                </interface>
                <routing-table>
                  <ip>
                    <static-route>
                      <entry name="to-internet">
                        <destination>192.168.100.0/24</destination>
                        <nexthop>
                          <ip-address>10.0.0.254</ip-address>
                        </nexthop>
                        <metric>5</metric>
                      </entry>
                    </static-route>
                  </ip>
                </routing-table>
              </entry>
            </logical-router>
          </network>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
