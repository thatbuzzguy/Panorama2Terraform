<?xml version="1.0"?>
<!-- Robustness: three different PAN-OS names that sanitize to the same -->
<!-- Terraform resource name (a-b, a_b, A-B -> a_b). Without collision -->
<!-- handling the generator emits duplicate resource addresses (invalid -->
<!-- HCL). With it, each object gets a unique resource name. -->
<config>
  <devices>
    <entry name="localhost.localdomain">
      <vsys>
        <entry name="vsys1">
          <address>
            <entry name="a-b">
              <ip-netmask>10.0.1.1/32</ip-netmask>
            </entry>
            <entry name="a_b">
              <ip-netmask>10.0.1.2/32</ip-netmask>
            </entry>
            <entry name="A-B">
              <ip-netmask>10.0.1.3/32</ip-netmask>
            </entry>
          </address>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
