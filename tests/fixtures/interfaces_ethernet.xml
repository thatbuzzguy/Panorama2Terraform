<?xml version="1.0"?>
<!-- F3.3: ethernet kinds. The physical L3 entry, a subinterface unit
     (units/entry), and the virtual-wire container. The provider has no
     virtual-wire resource type, so the virtual-wire entry emits as
     panos_ethernet_interface with a virtual_wire block.

     F4.4: the virtual-wire unit carries a comment, so the per-entry report line names
     a field the print reads and prints. `parent` is not a field for that entry: the
     type the block prints declares no parent attribute, and the name states the parent
     part, so the line names only what the print reads. -->
<config version="10.0.0" urldb="paloaltonetworks">
  <devices>
    <entry name="localhost.localdomain">
      <vsys>
        <entry name="vsys1">
          <network>
            <interface>
              <ethernet>
                <entry name="ethernet1/1">
                  <mode>layer3</mode>
                  <layer3>
                    <interface-management-profile>Management1</interface-management-profile>
                    <ip>
                      <entry name="192.168.1.1/24"/>
                    </ip>
                  </layer3>
                  <units>
                    <entry name="10">
                      <tag>10</tag>
                      <ip>
                        <entry name="192.168.1.10/24"/>
                      </ip>
                    </entry>
                  </units>
                  <comment>Trust uplink</comment>
                </entry>
                <entry name="ethernet1/2">
                  <mode>layer2</mode>
                  <layer2/>
                </entry>
                <entry name="ethernet1/3">
                  <mode>virtual-wire</mode>
                  <virtual-wire>
                    <tag>100</tag>
                  </virtual-wire>
                </entry>
                <entry name="ethernet1/5">
                  <mode>tap</mode>
                  <tap>
                    <tag>300</tag>
                  </tap>
                </entry>
              </ethernet>
              <virtual-wire>
                <units>
                  <entry name="ethernet1/4.1">
                    <virtual-wire>
                      <tag>200</tag>
                    </virtual-wire>
                    <comment>Wire unit on ethernet1/4</comment>
                  </entry>
                </units>
              </virtual-wire>
            </interface>
          </network>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
