<?xml version="1.0"?>
<config version="10.0.0" urldb="paloaltonetworks">
  <devices>
    <entry name="localhost.localdomain">
      <vsys>
        <entry name="vsys1">
          <network>
            <interface>
              <ethernet>
                <entry name="ethernet1/1">
                  <mode>layer3</mode>
                  <layer3>
                    <interface-management-profile>Management1</interface-management-profile>
                    <ip>
                      <entry name="192.168.1.1/24"/>
                    </ip>
                  </layer3>
                  <comment>Trust uplink</comment>
                </entry>
                <entry name="ethernet1/2">
                  <mode>layer2</mode>
                  <layer2/>
                </entry>
              </ethernet>
            </interface>
          </network>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
