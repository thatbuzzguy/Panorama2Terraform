<?xml version="1.0"?>
<config version="10.0.0" urldb="paloaltonetworks">
  <devices>
    <entry name="localhost.localdomain">
      <vsys>
        <entry name="vsys1">
          <network>
            <virtual-router>
              <entry name="default">
                <protocol>
                  <ospfv3>
                    <enable>yes</enable>
                    <router-id>10.0.0.1</router-id>
                    <area>
                      <entry name="0.0.0.0">
                        <!-- F7.2: the area type is a choice level, and the fields of the chosen body live
                             inside the chosen element -->
                        <type>
                          <nssa>
                            <accept-summary>yes</accept-summary>
                            <!-- F7.4: the export states the default-route choice as `no`, and the key the
                                 provider prints for it is `disable` -->
                            <default-route>
                              <no/>
                            </default-route>
                            <nssa-ext-range>
                              <entry name="10.20.0.0/16">
                                <name>10.20.0.0/16</name>
                                <advertise/>
                              </entry>
                            </nssa-ext-range>
                          </nssa>
                        </type>
                        <range>
                          <entry name="10.0.0.0/8">
                            <name>10.0.0.0/8</name>
                            <!-- F7.1: the provider requires exactly one of advertise or suppress -->
                            <suppress/>
                          </entry>
                        </range>
                        <!-- F7.2: an interface inside an area prints inside the area element -->
                        <interface>
                          <entry name="ethernet1/2">
                            <enable>yes</enable>
                            <passive>no</passive>
                            <link-type>point-to-point</link-type>
                            <metric>10</metric>
                            <!-- F7.4: a neighbor entry is the entry name, which is the whole shape -->
                            <neighbor>
                              <entry name="10.0.0.2"/>
                            </neighbor>
                          </entry>
                        </interface>
                        <!-- F7.4: the provider declares `instance_id` for a virtual link in this level only -->
                        <virtual-link>
                          <entry name="10.0.0.2">
                            <instance-id>1</instance-id>
                            <neighbor-id>10.0.0.3</neighbor-id>
                          </entry>
                        </virtual-link>
                      </entry>
                      <!-- F7.4: a `default-route` element with no child states neither choice the provider
                           requires, so the area entry that holds it has no `.tf` shape and the report names it -->
                      <entry name="0.0.1.0">
                        <type>
                          <nssa>
                            <default-route/>
                          </nssa>
                        </type>
                      </entry>
                    </area>
                    <!-- F7.2: the provider declares an interface only inside an area, so this one is named
                         by the report and the file holds no half of it -->
                    <interface>
                      <entry name="ethernet1/1">
                        <enable>yes</enable>
                        <metric>10</metric>
                      </entry>
                    </interface>
                  </ospfv3>
                </protocol>
              </entry>
              <!-- F7.3: the four levels `PROTOCOL_SHAPE` states for `protocol/ospfv3` outside `area`. The
                   three single-object levels read as one object, and an export rule is an entry, so the
                   property scan measures it against the router row. -->
              <entry name="edge-af">
                <protocol>
                  <ospfv3>
                    <enable>yes</enable>
                    <timers>
                      <lsa-interval>120</lsa-interval>
                      <spf-calculation-delay>20</spf-calculation-delay>
                    </timers>
                    <global-bfd>
                      <profile>BFD-OSP</profile>
                    </global-bfd>
                    <graceful-restart>
                      <enable>yes</enable>
                      <grace-period>120</grace-period>
                      <helper-enable>yes</helper-enable>
                      <max-neighbor-restart-time>200</max-neighbor-restart-time>
                      <!-- The provider spells this field `strict_l_s_a_checking`, so the element name is the
                           one case `XML_NAME_EXCEPTIONS` states -->
                      <strict-lsa-checking>yes</strict-lsa-checking>
                    </graceful-restart>
                    <export-rules>
                      <entry name="static-af">
                        <metric>10</metric>
                        <new-path-type>internal</new-path-type>
                        <new-tag>0</new-tag>
                      </entry>
                    </export-rules>
                  </ospfv3>
                </protocol>
              </entry>
            </virtual-router>
          </network>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
