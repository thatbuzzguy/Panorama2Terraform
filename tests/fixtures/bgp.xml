<?xml version="1.0"?>
<config version="10.0.0" urldb="paloaltonetworks">
  <devices>
    <entry name="localhost.localdomain">
      <vsys>
        <entry name="vsys1">
          <network>
            <virtual-router>
              <entry name="default">
                <protocol>
                  <bgp>
                    <enable>yes</enable>
                    <router-id>10.0.0.1</router-id>
                    <local-as>65001</local-as>
                    <peer-group>
                      <entry name="PG-Branch">
                        <type>external</type>
                        <export-nexthop>self</export-nexthop>
                        <import-nexthop>self</import-nexthop>
                      </entry>
                    </peer-group>
                    <peer>
                      <entry name="10.55.0.2">
                        <peer-as>65002</peer-as>
                        <local-address>
                          <ip>10.55.0.1</ip>
                        </local-address>
                        <peer-address>
                          <ip>10.55.0.2</ip>
                        </peer-address>
                        <enable>yes</enable>
                        <peer-group>PG-Branch</peer-group>
                      </entry>
                      <!-- F7.1: no provider field holds a peer outside a peer group, so this entry is
                           named in the manual setup report -->
                      <entry name="10.55.0.9">
                        <peer-as>65003</peer-as>
                        <peer-address>
                          <ip>10.55.0.9</ip>
                        </peer-address>
                        <enable>yes</enable>
                      </entry>
                    </peer>
                    <redist-rules>
                      <entry name="redist-static">
                        <enable>yes</enable>
                        <address-family-identifier>ipv4-unicast</address-family-identifier>
                      </entry>
                    </redist-rules>
                  </bgp>
                </protocol>
              </entry>
              <entry name="vr-nobgp">
                <protocol>
                  <bgp>
                    <enable>no</enable>
                  </bgp>
                </protocol>
              </entry>
            </virtual-router>
          </network>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
