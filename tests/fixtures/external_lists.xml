<?xml version="1.0"?>
<config version="10.0.0" urldb="paloaltonetworks">
  <shared>
    <external-list>
      <entry name="threat-ips">
        <type>
          <ip>
            <url>https://threat.example.com/list.txt</url>
            <recurring>
              <hourly>
                <entry name="hourly">
                  <hour>
                    <member>0</member>
                  </hour>
                </entry>
              </hourly>
            </recurring>
          </ip>
        </type>
        <description>Threat IP list</description>
      </entry>
    </external-list>
  </shared>
</config>
