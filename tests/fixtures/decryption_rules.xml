<?xml version="1.0"?>
<config version="10.0.0" urldb="paloaltonetworks">
  <devices>
    <entry name="localhost.localdomain">
      <device-group>
        <entry name="Production-DG">
          <pre-rulebase>
            <decryption>
              <rules>
                <entry name="Decrypt-HTTPS" uuid="abc-123">
                  <from>
                    <member>Trust</member>
                  </from>
                  <to>
                    <member>Untrust</member>
                  </to>
                  <source>
                    <member>Internal-Network</member>
                  </source>
                  <destination>
                    <member>any</member>
                  </destination>
                  <service>
                    <member>service-https</member>
                  </service>
                  <!-- Modern PAN-OS 10/11 shape: the v2 action enum plus a
                       type block that names the inspection mode -->
                  <action>decrypt</action>
                  <type>
                    <ssl-forward-proxy/>
                  </type>
                  <profile>ssl-decrypt-policy</profile>
                  <log-setting>default</log-setting>
                  <log-start>yes</log-start>
                  <log-end>no</log-end>
                  <description>Decrypt HTTPS</description>
                </entry>
                <entry name="Decrypt-SSH" uuid="abc-456">
                  <from>
                    <member>Trust</member>
                  </from>
                  <to>
                    <member>Untrust</member>
                  </to>
                  <source>
                    <member>Internal-Network</member>
                  </source>
                  <destination>
                    <member>any</member>
                  </destination>
                  <service>
                    <member>service-ssh</member>
                  </service>
                  <!-- Legacy PAN-OS 9 shape: the inspection mode in the
                       action field, no type block. The converter maps it
                       to action=decrypt + type=ssh_proxy for v2. -->
                  <action>ssh-proxy</action>
                  <profile>ssh-decrypt-profile</profile>
                  <log-setting>default</log-setting>
                  <log-start>yes</log-start>
                  <log-end>yes</log-end>
                  <description>Decrypt SSH</description>
                </entry>
              </rules>
            </decryption>
          </pre-rulebase>
        </entry>
      </device-group>
    </entry>
  </devices>
</config>
