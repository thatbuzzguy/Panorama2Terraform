<?xml version="1.0"?>
<config version="10.0.0" urldb="paloaltonetworks">
  <templates>
    <entry name="FW-Template">
      <network>
        <logical-router>
          <entry name="lr-main">
            <interface>
              <member>ethernet1/1</member>
            </interface>
            <routing-table>
              <ip>
                <static-route>
                  <entry name="lr-default">
                    <destination>default</destination>
                    <nexthop>
                      <next-lr>lr-peer</next-lr>
                    </nexthop>
                  </entry>
                </static-route>
              </ip>
            </routing-table>
          </entry>
        </logical-router>
      </network>
    </entry>
  </templates>
</config>
