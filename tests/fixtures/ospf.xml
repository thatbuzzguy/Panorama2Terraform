<?xml version="1.0"?>
<config version="10.0.0" urldb="paloaltonetworks">
  <devices>
    <entry name="localhost.localdomain">
      <vsys>
        <entry name="vsys1">
          <network>
            <virtual-router>
              <entry name="default">
                <protocol>
                  <ospf>
                    <!-- F7.9: the fields the `protocol/ospf` row declares. One entry states every field its
                         row declares, so the property scan has no unused property for it. The print order is
                         the row's field order. -->
                    <enable>yes</enable>
                    <router-id>10.0.0.1</router-id>
                    <allow-redist-default-route>yes</allow-redist-default-route>
                    <reject-default-route>no</reject-default-route>
                    <rfc1583>yes</rfc1583>
                    <timers>
                      <lsa-interval>120</lsa-interval>
                      <spf-calculation-delay>20</spf-calculation-delay>
                    </timers>
                    <global-bfd>
                      <profile>BFD-OSPF</profile>
                    </global-bfd>
                    <graceful-restart>
                      <enable>yes</enable>
                      <grace-period>120</grace-period>
                      <helper-enable>yes</helper-enable>
                      <max-neighbor-restart-time>200</max-neighbor-restart-time>
                      <!-- `strict_l_s_a_checking` is the one spelling the `-` rule cannot produce -->
                      <strict-lsa-checking>yes</strict-lsa-checking>
                    </graceful-restart>
                    <export-rules>
                      <entry name="export-static">
                        <metric>10</metric>
                        <new-path-type>internal</new-path-type>
                        <new-tag>0</new-tag>
                      </entry>
                    </export-rules>
                    <area>
                      <entry name="0.0.0.0">
                        <!-- F7.2: the fields of the chosen body live inside the chosen element, so this flag
                             prints inside the `stub` body -->
                        <type>
                          <stub>
                            <accept-summary>yes</accept-summary>
                            <!-- F7.4: `default-route` is the one choice the provider requires inside the body,
                                 so the export states it by presence and the print states the key -->
                            <default-route>
                              <advertise>
                                <metric>10</metric>
                              </advertise>
                            </default-route>
                          </stub>
                        </type>
                        <range>
                          <entry name="10.0.0.0/8">
                            <name>10.0.0.0/8</name>
                            <!-- F7.1: the provider requires exactly one of advertise or suppress -->
                            <advertise/>
                          </entry>
                          <!-- F7.1: an entry that states neither has no `.tf` shape, so the manual report
                               names it -->
                          <entry name="10.60.0.0/16">
                            <name>10.60.0.0/16</name>
                          </entry>
                        </range>
                        <!-- F7.1: an interface inside an area prints inside the area element -->
                        <interface>
                          <entry name="ethernet1/2">
                            <enable>yes</enable>
                            <passive>no</passive>
                            <link-type>broadcast</link-type>
                            <metric>10</metric>
                            <!-- F7.4: a neighbor entry is the entry name, which is the whole shape -->
                            <neighbor>
                              <entry name="10.0.0.2"/>
                            </neighbor>
                          </entry>
                          <!-- F7.1: a value the mapping cannot state makes the entry not expressible, so
                               the report names the whole entry -->
                          <entry name="ethernet1/3">
                            <enable>yes</enable>
                            <link-type>multicast</link-type>
                          </entry>
                        </interface>
                        <!-- F7.4: a virtual link prints inside the area, and the provider declares no
                             `instance_id` for this level -->
                        <virtual-link>
                          <entry name="10.0.0.2">
                            <neighbor-id>10.0.0.3</neighbor-id>
                            <transit-area-id>0.0.0.1</transit-area-id>
                            <hello-interval>10</hello-interval>
                          </entry>
                        </virtual-link>
                      </entry>
                      <!-- F7.4: the `nssa` body holds the second shape the parse reads: the entries of
                           `nssa_ext_range`, and the `default-route` choice the export states as `no` -->
                      <entry name="0.0.1.0">
                        <type>
                          <nssa>
                            <default-route>
                              <no/>
                            </default-route>
                            <nssa-ext-range>
                              <entry name="10.20.0.0/16">
                                <name>10.20.0.0/16</name>
                                <suppress/>
                              </entry>
                              <!-- F7.4: an entry that states neither has no `.tf` shape, so the manual report
                                   names it -->
                              <entry name="10.30.0.0/16">
                                <name>10.30.0.0/16</name>
                              </entry>
                            </nssa-ext-range>
                          </nssa>
                        </type>
                      </entry>
                    </area>
                    <interface>
                      <entry name="ethernet1/1">
                        <enable>yes</enable>
                        <passive>yes</passive>
                        <link-type>point-to-point</link-type>
                        <metric>10</metric>
                      </entry>
                    </interface>
                  </ospf>
                </protocol>
              </entry>
            </virtual-router>
          </network>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
