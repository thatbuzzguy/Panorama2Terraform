<?xml version="1.0"?>
<config version="10.0.0" urldb="paloaltonetworks">
  <devices>
    <entry name="localhost.localdomain">
      <vsys>
        <entry name="vsys1">
          <network>
            <virtual-router>
              <entry name="default">
                <protocol>
                  <ospf>
                    <enable>yes</enable>
                    <router-id>10.0.0.1</router-id>
                    <area>
                      <entry name="0.0.0.0">
                        <type>
                          <stub/>
                        </type>
                        <range>
                          <entry name="10.0.0.0/8">
                            <name>10.0.0.0/8</name>
                          </entry>
                        </range>
                      </entry>
                    </area>
                    <interface>
                      <entry name="ethernet1/1">
                        <enable>yes</enable>
                        <passive>yes</passive>
                        <link-type>point-to-point</link-type>
                        <metric>10</metric>
                      </entry>
                    </interface>
                  </ospf>
                </protocol>
              </entry>
            </virtual-router>
          </network>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
