<?xml version="1.0"?>
<config version="10.0.0" urldb="paloaltonetworks">
  <devices>
    <entry name="localhost.localdomain">
      <device-group>
        <entry name="Production-DG">
          <pre-rulebase>
            <nat>
              <rules>
                <entry name="Outbound-NAT">
                  <from>
                    <member>Trust</member>
                  </from>
                  <to-interface>Untrust</to-interface>
                  <source>
                    <member>Internal-Network</member>
                  </source>
                  <destination>
                    <member>any</member>
                  </destination>
                  <service>any</service>
                  <source-translation>
                    <dynamic-ip-and-port>
                      <translated-address>
                        <member>Untrust-Interface</member>
                      </translated-address>
                    </dynamic-ip-and-port>
                  </source-translation>
                  <description>Outbound NAT</description>
                </entry>
                <entry name="Inbound-Web-NAT">
                  <from>
                    <member>Untrust</member>
                  </from>
                  <to-interface>DMZ</to-interface>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>Public-IP</member>
                  </destination>
                  <service>service-http</service>
                  <destination-translation>
                    <translated-address>10.1.1.10</translated-address>
                    <translated-port>80</translated-port>
                  </destination-translation>
                  <description>Inbound NAT for web</description>
                </entry>
                <!-- F4.4: the service field in member-list form, one member. The text form above
                     is the other form the export states. -->
                <entry name="Member-Form-NAT">
                  <from>
                    <member>Untrust</member>
                  </from>
                  <to-interface>DMZ</to-interface>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>Public-IP</member>
                  </destination>
                  <service>
                    <member>service-http</member>
                  </service>
                  <description>NAT stated as one member</description>
                </entry>
                <!-- F4.4: a member list the v2 string field cannot hold, so the block names it -->
                <entry name="Multi-Member-NAT">
                  <from>
                    <member>Untrust</member>
                  </from>
                  <to-interface>DMZ</to-interface>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>Public-IP</member>
                  </destination>
                  <service>
                    <member>service-http</member>
                    <member>service-https</member>
                  </service>
                  <description>NAT stated as two members</description>
                </entry>
              </rules>
            </nat>
          </pre-rulebase>
        </entry>
      </device-group>
    </entry>
  </devices>
</config>
