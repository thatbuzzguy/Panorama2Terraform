<?xml version="1.0"?>
<!-- Edge case: the same object name defined under two different vsys of
     the same device group. F3.1 keys objects by (device group, vsys,
     type, name), so both must survive parsing. F3.2 carries that identity
     to emit: each object gets its own digest, each rule resolves the name
     in its own vsys, and each vsys keeps its own rule chain. -->
<config version="10.0.0" urldb="paloaltonetworks">
  <devices>
    <entry name="localhost.localdomain">
      <vsys>
        <entry name="vsys1">
          <address>
            <entry name="web">
              <ip-netmask>10.1.0.1/32</ip-netmask>
            </entry>
          </address>
          <rulebase>
            <security>
              <rules>
                <entry name="rule-vs1-a">
                  <from><member>Trust</member></from>
                  <to><member>Untrust</member></to>
                  <source><member>web</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <service><member>application-default</member></service>
                  <action>allow</action>
                </entry>
                <entry name="rule-vs1-b">
                  <from><member>Trust</member></from>
                  <to><member>Untrust</member></to>
                  <source><member>web</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <service><member>application-default</member></service>
                  <action>allow</action>
                </entry>
              </rules>
            </security>
          </rulebase>
        </entry>
        <entry name="vsys2">
          <address>
            <entry name="web">
              <ip-netmask>10.2.0.1/32</ip-netmask>
            </entry>
          </address>
          <rulebase>
            <security>
              <rules>
                <entry name="rule-vs2-a">
                  <from><member>Trust</member></from>
                  <to><member>Untrust</member></to>
                  <source><member>web</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <service><member>application-default</member></service>
                  <action>allow</action>
                </entry>
                <entry name="rule-vs2-b">
                  <from><member>Trust</member></from>
                  <to><member>Untrust</member></to>
                  <source><member>web</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <service><member>application-default</member></service>
                  <action>allow</action>
                </entry>
              </rules>
            </security>
          </rulebase>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
