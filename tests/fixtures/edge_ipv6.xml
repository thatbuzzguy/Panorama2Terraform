<?xml version="1.0"?>
<!-- Edge case: an IPv6 address object next to an IPv4 one. -->
<!-- The parser currently only understands ip-netmask / ip-range / fqdn, -->
<!-- so the IPv6 entry drops its value (Epic 2 F2.4). -->
<config version="10.0.0" urldb="paloaltonetworks">
  <devices>
    <entry name="localhost.localdomain">
      <vsys>
        <entry name="vsys1">
          <address>
            <entry name="v4-host">
              <ip-netmask>192.168.1.10/32</ip-netmask>
            </entry>
            <entry name="v6-host" type="ipv6">
              <ipv6>2001:db8::10/128</ipv6>
            </entry>
            <entry name="v6-range" type="ipv6">
              <ipv6>2001:db8::/48</ipv6>
            </entry>
          </address>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
