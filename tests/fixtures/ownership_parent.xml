<?xml version="1.0"?>
<!-- F6.5 ownership fixture: the case F6.2 rule 4 could not decide before the parse captured the
     device-group `parent`. Two device groups repeat one name, and the export states which one is the
     ancestor, so the rule names the owner and the repeat is not a finding.

  Printer-Pool  Child-DG states Parent-DG as its parent, so Parent-DG owns the name and Child-DG
                resolves as an override. No finding: the rule decides it.

Two top-level groups that repeat a name are peers, because the export states no parent for either,
and that case stays a finding (`edge_dup_names_across_dgs.xml`). -->
<config version="10.0.0" urldb="paloaltonetworks">
  <devices>
    <entry name="localhost.localdomain">
      <device-group>
        <entry name="Parent-DG">
          <description>Top-level group</description>
          <address>
            <entry name="Printer-Pool">
              <ip-netmask>10.40.0.20/32</ip-netmask>
            </entry>
          </address>
        </entry>
        <entry name="Child-DG">
          <parent>Parent-DG</parent>
          <address>
            <entry name="Printer-Pool">
              <ip-netmask>10.40.0.21/32</ip-netmask>
            </entry>
          </address>
        </entry>
      </device-group>
    </entry>
  </devices>
</config>
