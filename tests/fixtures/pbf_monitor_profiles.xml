<?xml version="1.0"?>
<config version="10.0.0" urldb="paloaltonetworks">
  <devices>
    <entry name="localhost.localdomain">
      <vsys>
        <entry name="vsys1">
          <network>
            <!-- PBF path monitoring profiles (F2.9): the provider manages
                 these as panos_monitor_profile. A different PAN-OS object
                 from the IPsec tunnel monitor profile. -->
            <profiles>
              <monitor-profile>
                <entry name="PM-Branch" uuid="pm-1">
                  <action>wait-recover</action>
                  <interval>10</interval>
                  <threshold>5</threshold>
                </entry>
                <entry name="PM-HQ" uuid="pm-2">
                  <action>fail-over</action>
                  <interval>30</interval>
                  <threshold>3</threshold>
                </entry>
              </monitor-profile>
            </profiles>
          </network>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
