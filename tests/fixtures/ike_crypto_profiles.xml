<?xml version="1.0"?>
<config version="10.0.0" urldb="paloaltonetworks">
  <devices>
    <entry name="localhost.localdomain">
      <vsys>
        <entry name="vsys1">
          <network>
            <ike>
              <crypto-profiles>
                <ike-crypto-profiles>
                  <entry name="IKE-DEFAULT">
                    <dh-group>
                      <member>group14</member>
                    </dh-group>
                    <authentication>
                      <member>sha256</member>
                    </authentication>
                    <encryption>
                      <member>aes256</member>
                    </encryption>
                    <lifetime>
                      <hours>24</hours>
                    </lifetime>
                  </entry>
                </ike-crypto-profiles>
              </crypto-profiles>
            </ike>
          </network>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
