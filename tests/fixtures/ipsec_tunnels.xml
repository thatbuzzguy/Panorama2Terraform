<?xml version="1.0"?>
<config version="10.0.0" urldb="paloaltonetworks">
  <devices>
    <entry name="localhost.localdomain">
      <vsys>
        <entry name="vsys1">
          <network>
            <tunnel>
              <ipsec>
                <entry name="TUN-Branch">
                  <tunnel-interface>tunnel.1</tunnel-interface>
                  <auto-key>
                    <gateway>
                      <entry name="IKE-GW-Branch"/>
                    </gateway>
                    <ipsec-crypto-profile>IPSEC-DEFAULT</ipsec-crypto-profile>
                    <proxy-id>
                      <entry name="proxy-1">
                        <local>10.0.0.0/8</local>
                        <remote>192.168.0.0/16</remote>
                        <protocol>
                          <number>17</number>
                        </protocol>
                      </entry>
                    </proxy-id>
                  </auto-key>
                </entry>
              </ipsec>
            </tunnel>
          </network>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
