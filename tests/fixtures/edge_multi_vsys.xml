<?xml version="1.0"?>
<!-- Edge case: objects defined under two different vsys. -->
<!-- The parser currently flattens all vsys into one namespace. -->
<config version="10.0.0" urldb="paloaltonetworks">
  <devices>
    <entry name="localhost.localdomain">
      <vsys>
        <entry name="vsys1">
          <address>
            <entry name="host-vs1">
              <ip-netmask>10.9.1.10/32</ip-netmask>
            </entry>
          </address>
        </entry>
        <entry name="vsys2">
          <address>
            <entry name="host-vs2">
              <ip-netmask>10.9.2.10/32</ip-netmask>
            </entry>
          </address>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
