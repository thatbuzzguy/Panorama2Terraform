<?xml version="1.0"?>
<config version="10.0.0" urldb="paloaltonetworks">
  <devices>
    <entry name="localhost.localdomain">
      <vsys>
        <entry name="vsys1">
          <network>
            <virtual-router>
              <entry name="default">
                <protocol>
                  <!-- F7.5: the `rip` levels `PROTOCOL_SHAPE` states. `rip` declares no router id, no area
                       and no neighbor, so the level prints no field for them -->
                  <rip>
                    <enable>yes</enable>
                    <allow-redist-default-route>yes</allow-redist-default-route>
                    <reject-default-route>no</reject-default-route>
                    <timers>
                      <interval-seconds>30</interval-seconds>
                      <update-intervals>180</update-intervals>
                      <expire-intervals>210</expire-intervals>
                      <delete-intervals>120</delete-intervals>
                    </timers>
                    <global-bfd>
                      <profile>BFD-RIP</profile>
                    </global-bfd>
                    <!-- F7.5: the export states a name-keyed list as an entry, so an interface and an export
                         rule are entries the ledger records -->
                    <interfaces>
                      <entry name="ethernet1/2">
                        <enable>yes</enable>
                        <mode>v2</mode>
                        <authentication>md5</authentication>
                        <bfd>
                          <profile>BFD-RIP</profile>
                        </bfd>
                        <!-- The choice the entry holds inside itself: the print states the key the row selects -->
                        <default-route>
                          <advertise>
                            <metric>10</metric>
                          </advertise>
                        </default-route>
                      </entry>
                      <!-- F7.5: the export states this alternative as `no`, and the key the print states for
                           it is `disable` -->
                      <entry name="ethernet1/3">
                        <enable>no</enable>
                        <mode>v1</mode>
                        <default-route>
                          <no/>
                        </default-route>
                      </entry>
                      <!-- F7.5: a choice element that states none of the alternatives the provider requires
                           has no `.tf` shape, so the report names the entry that holds it -->
                      <entry name="ethernet1/4">
                        <mode>v2</mode>
                        <default-route/>
                      </entry>
                    </interfaces>
                    <export-rules>
                      <entry name="static-af">
                        <metric>10</metric>
                      </entry>
                    </export-rules>
                  </rip>
                </protocol>
              </entry>
            </virtual-router>
          </network>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
