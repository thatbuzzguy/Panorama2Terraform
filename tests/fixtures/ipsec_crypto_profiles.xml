<?xml version="1.0"?>
<config version="10.0.0" urldb="paloaltonetworks">
  <devices>
    <entry name="localhost.localdomain">
      <vsys>
        <entry name="vsys1">
          <network>
            <ike>
              <crypto-profiles>
                <ipsec-crypto-profiles>
                  <entry name="IPSEC-DEFAULT">
                    <esp>
                      <encryption>
                        <member>aes256</member>
                      </encryption>
                      <authentication>
                        <member>sha256</member>
                      </authentication>
                    </esp>
                    <dh-group>group14</dh-group>
                    <lifetime>
                      <hours>1</hours>
                      <kilobytes>4608000</kilobytes>
                    </lifetime>
                  </entry>
                </ipsec-crypto-profiles>
              </crypto-profiles>
            </ike>
          </network>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
